# Copy to .env for local development. In production set these in the
# Catalyst AppSail environment variables instead. The app loads .env at
# startup, but real environment variables always take precedence.
#
# To point local runs at a different database (for example a Neon dev branch)
# without touching the deployed configuration, put just those overrides in
# .env.local: it is loaded after .env and wins. It is git-ignored.

# --- Database (Neon) ---
# Use the POOLED string (host contains "-pooler") for the application.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require
# Optional. The direct (unpooled) string, for migrations and pg_dump only.
DATABASE_URL_UNPOOLED=postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require

# --- Attendance rules ---
CODE_VALIDITY_MINUTES=15
LOCATION_REQUIRED=true
# Students may mark attendance anywhere inside this campus circle.
CAMPUS_CENTER_LATITUDE=12.987929
CAMPUS_CENTER_LONGITUDE=79.972311
CAMPUS_RADIUS_METERS=120
# Extra metres allowed outside the boundary for a noisy fix. 0 enforces the
# 120 m circle exactly; raise it only if students inside are rejected at the
# edge because of GPS drift.
CAMPUS_ACCURACY_TOLERANCE_METERS=0
# Fixes worse than this are rejected as too unreliable.
MAX_GPS_ACCURACY_METERS=100
# Deprecated, still read as fallbacks when the CAMPUS_* values are absent:
# CLASSROOM_LATITUDE, CLASSROOM_LONGITUDE, MAX_ATTENDANCE_DISTANCE_METERS.

# --- Semester window (optional, used for reporting) ---
SEMESTER_START=2026-07-01
SEMESTER_END=2026-11-30

# --- Web app origin allowed to call this API ---
# The Flutter web app is normally served from this same AppSail origin, so
# browser calls are same-origin and CORS does not apply. Only set this if you
# host the UI somewhere else (see WEB_DIR below).
ALLOWED_ORIGINS=*

# --- Static UI ---
# Directory holding the compiled Flutter web app ("flutter build web" output).
# Defaults to ./web next to main.py, which is where build_appsail.ps1 puts it.
# Point it at ../attendance_app/build/web to serve the UI while running locally.
# WEB_DIR=

# --- Staff accounts ---
# Staff choose their own password the first time they sign in, and must type
# this code to do it. Hand it to staff out of band (notice board, WhatsApp,
# staff meeting). Change it here to retire the old one. While it is empty,
# self-service setup is switched off and only an administrator can clear an
# account (see clear_staff_passwords.py).
STAFF_SETUP_CODE=

# --- Email (Catalyst Mail / any SMTP provider) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- ERP delivery ---
# file = download + email; api = push to a college ERP endpoint
ERP_MODE=file
ERP_UPLOAD_EMAIL=
ERP_API_URL=
ERP_API_KEY=

# --- Danger: enables the destructive reset endpoint ---
RESET_DB_ENABLED=false

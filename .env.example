# Copy to .env for local development. In production set these in the
# Catalyst AppSail environment variables instead.

# --- Database (Neon) ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Attendance rules ---
CODE_VALIDITY_MINUTES=15
MAX_ATTENDANCE_DISTANCE_METERS=120
LOCATION_REQUIRED=true
CLASSROOM_LATITUDE=12.9869153
CLASSROOM_LONGITUDE=79.9724422

# --- Semester window (optional, used for reporting) ---
SEMESTER_START=2026-07-01
SEMESTER_END=2026-11-30

# --- Web app origin allowed to call this API ---
ALLOWED_ORIGINS=https://your-app.catalystserverless.in

# --- Email (Catalyst Mail / any SMTP provider) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- ERP delivery ---
# file = download + email; api = push to a college ERP endpoint
ERP_MODE=file
ERP_UPLOAD_EMAIL=
ERP_API_URL=
ERP_API_KEY=

# --- Danger: enables the destructive reset endpoint ---
RESET_DB_ENABLED=false
